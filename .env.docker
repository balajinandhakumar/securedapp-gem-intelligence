# SecuredApp GeM Bid Intelligence — Docker Compose Environment
#
# Copy this file to `.env` before running `docker compose up` for Docker
# deployment. Do NOT overwrite the existing local `.env` used for development.
#
# Never commit this file with real secrets — it is gitignored.

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================================================
# Security (REQUIRED for production)
# ============================================================================
# Generate a strong random secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=set_this_locally_and_never_commit
AUTH_REQUIRED=true
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Database (PostgreSQL via Docker Compose)
# ============================================================================
POSTGRES_USER=securedapp
POSTGRES_PASSWORD=set_this_locally_and_never_commit
POSTGRES_DB=securedapp_gem
DATABASE_URL=postgresql+psycopg2://securedapp:set_this_locally_and_never_commit@db:5432/securedapp_gem
REDIS_URL=redis://redis:6379/0

# ============================================================================
# CORS
# ============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3066","http://127.0.0.1:3066"]

# ============================================================================
# Trusted hosts (production)
# ============================================================================
TRUSTED_HOSTS=localhost,127.0.0.1

# ============================================================================
# Rate limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================================================
# Direct GeM Public Collector
# ============================================================================
GEM_DIRECT_ENABLED=true
GEM_DIRECT_ALLOWED_HOSTS=gem.gov.in,bidplus.gem.gov.in
GEM_DIRECT_SCHEDULER_ENABLED=true
GEM_DIRECT_SCHEDULER_INTERVAL_MINUTES=20
GEM_DIRECT_MAX_PAGES=250
GEM_DIRECT_USE_PLAYWRIGHT=true
GEM_DIRECT_AUTO_RESUME=false
GEM_DIRECT_BID_STATUS_TYPE=ongoing_bids
GEM_DIRECT_SORT_ORDER=Bid-Start-Date-Latest
GEM_DIRECT_BID_TYPE=all
GEM_DIRECT_KEYWORD_FILTER_ENABLED=false
GEM_DIRECT_ENRICH_DETAIL_PAGES=false
GEM_DIRECT_DOC_EXTRACTION_ENABLED=false
GEM_DIRECT_MAX_DOC_PAGES=20
GEM_BOQ_AUTO_ENRICH_ENABLED=false
GEM_BOQ_AUTO_ENRICH_MAX_PER_RUN=25

# ============================================================================
# Multi-source scheduler (state/UT portals)
# ============================================================================
SOURCE_SCHEDULER_ENABLED=true
SOURCE_SCHEDULER_TICK_SECONDS=60
SOURCE_ALLOWED_HOSTS=
SOURCE_ALLOWED_SECRET_ENVS=

# ============================================================================
# Email notifications (SMTP)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ============================================================================
# Frontend (Vite)
# ============================================================================
VITE_ENVIRONMENT=production
VITE_BACKEND_URL=http://backend:8000

# ============================================================================
# Demo login (development only)
# ============================================================================
VITE_DEMO_LOGIN_ENABLED=false
VITE_DEMO_LOGIN_AUTHORIZED=

# Demo account credentials (development only)
# VITE_DEMO_EMAIL=demo@securedapp.io
# VITE_DEMO_PASSWORD=set_this_locally_and_never_commit
