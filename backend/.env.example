# ---------------------------------------------------------------------------
# Backend environment configuration (production-ready template)
#
# Copy this file to `backend/.env` and adjust for your deployment.
# `backend/.env` is gitignored and must never be committed.
# Never put real secrets here — supply them via environment variables or a
# secret manager at deploy time.
# ---------------------------------------------------------------------------

# ---- Environment ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Security (REQUIRED for production) ----
# Set a strong random secret (32+ bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=set_this_locally_and_never_commit
AUTH_REQUIRED=false
# Set to true for production deployment (enforces authentication on protected
# endpoints). The application will refuse to start in production with the dev
# default key or AUTH_REQUIRED=false.
# AUTH_REQUIRED=true

# ---- Authentication ----
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ---- Database ----
# Development: SQLite (single-user demo)
DATABASE_URL=sqlite:///./dev.db
TEST_DATABASE_URL=sqlite:///./test.db

# Production: PostgreSQL (multi-user). Supply via environment at deploy time.
# DATABASE_URL=postgresql://securedapp:CHANGE_ME@db:5432/securedapp_gem

# ---- CORS ----
# Development origins. Replace with exact production frontend origin(s).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Trusted hosts (production) ----
# Set to exact production host(s), e.g. TRUSTED_HOSTS=app.example.com
# Leave unset for development (allows all hosts).
TRUSTED_HOSTS=

# ---- Direct GeM Public Collector ----
GEM_DIRECT_ENABLED=true
GEM_DIRECT_ALLOWED_HOSTS=gem.gov.in,bidplus.gem.gov.in
GEM_DIRECT_SCHEDULER_ENABLED=true
GEM_DIRECT_SCHEDULER_INTERVAL_MINUTES=20
GEM_DIRECT_MAX_PAGES=250
GEM_DIRECT_USE_PLAYWRIGHT=true
GEM_DIRECT_AUTO_RESUME=false
GEM_DIRECT_BID_STATUS_TYPE=ongoing_bids
GEM_DIRECT_SORT_ORDER=Bid-Start-Date-Latest
GEM_DIRECT_BID_TYPE=all
GEM_DIRECT_KEYWORD_FILTER_ENABLED=false
GEM_DIRECT_ENRICH_DETAIL_PAGES=false
GEM_DIRECT_DOC_EXTRACTION_ENABLED=false

# ---- Multi-source scheduler (state/UT portals) ----
SOURCE_SCHEDULER_ENABLED=true
SOURCE_SCHEDULER_TICK_SECONDS=60
SOURCE_ALLOWED_HOSTS=
SOURCE_ALLOWED_SECRET_ENVS=

# ---- Email notifications (SMTP) ----
# Server-side only. Notifications stay QUEUED until SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- Frontend demo login (development only) ----
# Controlled by frontend/.env, not this file. See frontend/.env.example.
