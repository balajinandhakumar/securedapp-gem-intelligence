# ---------------------------------------------------------------------------
# Frontend (Vite) environment configuration
#
# Copy this file to `.env` and adjust for your environment. `.env` is
# gitignored and must never be committed.
#
# Variables prefixed with `VITE_` are exposed to the frontend bundle at build
# time. Only set non-secret, deployment-specific values here.
# ---------------------------------------------------------------------------

VITE_ENVIRONMENT=production

# Backend API URL. For Docker Compose, this must point to the backend service:
#   VITE_BACKEND_URL=http://backend:8000
# For local development:
#   VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_BACKEND_URL=http://backend:8000

# ---------------------------------------------------------------------------
# Demo login (development only)
# ---------------------------------------------------------------------------
# Set VITE_DEMO_LOGIN_ENABLED=true to show the "Demo Login" button on the
# login page. Demo Login authenticates through the real backend
# (POST /api/v1/auth/login) — no fake session, no bypass, no mocked token.
#
# The button is hidden in production unless BOTH
#   VITE_DEMO_LOGIN_ENABLED=true  AND  VITE_DEMO_LOGIN_AUTHORIZED=true
# are set. Never enable demo login in production unless explicitly authorized
# by the deployment configuration.
#
# A matching demo user must exist in the backend database before Demo Login
# can succeed (create one via POST /api/v1/auth/users).
# ---------------------------------------------------------------------------

VITE_DEMO_LOGIN_ENABLED=false

# Explicit production authorization (required in addition to the flag above
# when VITE_ENVIRONMENT=production). Leave unset or false by default.
VITE_DEMO_LOGIN_AUTHORIZED=

# Demo account credentials (development only). The owner must set these
# locally in `.env` (gitignored) before Demo Login can work. Never bake
# real credentials into source code or commit them.
# VITE_DEMO_EMAIL=demo@securedapp.io
# VITE_DEMO_PASSWORD=set_this_locally_and_never_commit
